# ===== Google OAuth (required for Sign in with Google) =====
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URIs:
#    - http://localhost:80/guidance/auth/callback
#    - http://127.0.0.1:80/guidance/auth/callback
#    (Add your production URL when deploying)
# 4. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback URL (must match exactly what's in Google Console)
# For local dev with gateway on port 80:
REDIRECT_URI=http://localhost:80/guidance/auth/callback

# Where to redirect after successful login (frontend URL)
FRONTEND_URL=http://localhost:5173

# Session secret (use a random string in production)
SECRET_KEY=change-me-in-production

# ===== CA guidance: Google Gemini (recommended) =====
# Get an API key from https://aistudio.google.com/apikey — used only for the guidance Crew (tutor agent + finalize).
# If GEMINI_API_KEY is unset, CA guidance falls back to OPENAI_API_KEY + gpt-4o.
GEMINI_API_KEY=
# Use a model your API key can call (see Google AI Studio / Vertex list). Common: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro.
# Preview IDs (e.g. gemini-3-*) often return 404 unless your project is allowlisted.
CA_GUIDANCE_GEMINI_MODEL=gemini-2.0-flash

# CA guidance crew (OpenAI chat): model, max output tokens, per-chunk char budget (question-boundary chunking)
# CA_GUIDANCE_MODEL=gpt-4o
# CA_GUIDANCE_MAX_OUTPUT_TOKENS=16384
# CA_GUIDANCE_CHUNK_MAX_CHARS=14000

# ===== OpenAI (RAG, summarization, diagram tools, etc.) =====
OPENAI_API_KEY=

# Optional: CA guidance — ER diagrams as Graphviz DOT (chat), flowcharts as PNG (Images API)
# ASSIGNMENT_ER_GRAPHVIZ_MODEL=gpt-4o-mini
# Optional Graphviz renderer endpoint for ER image rendering
# GRAPHVIZ_RENDER_URL=https://kroki.io/graphviz/png
# ENABLE_ASSIGNMENT_DIAGRAM_IMAGES=true
# ASSIGNMENT_DIAGRAM_IMAGE_MODEL=dall-e-3

# ===== MongoDB =====
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ca_guidance_db
