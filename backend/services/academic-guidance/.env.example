# ===== Google OAuth (required for Sign in with Google) =====
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URIs:
#    - http://localhost:80/guidance/auth/callback
#    - http://127.0.0.1:80/guidance/auth/callback
#    (Add your production URL when deploying)
# 4. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback URL (must match exactly what's in Google Console)
# For local dev with gateway on port 80:
REDIRECT_URI=http://localhost:80/guidance/auth/callback

# Where to redirect after successful login (frontend URL)
FRONTEND_URL=http://localhost:5173

# Session secret (use a random string in production)
SECRET_KEY=change-me-in-production

# ===== OpenAI (for RAG, guidance, etc.) =====
OPENAI_API_KEY=

# Optional: CA guidance — ER diagrams as Graphviz DOT (chat), flowcharts as PNG (Images API)
# ASSIGNMENT_ER_GRAPHVIZ_MODEL=gpt-4o-mini
# Optional Graphviz renderer endpoint for ER image rendering
# GRAPHVIZ_RENDER_URL=https://kroki.io/graphviz/png
# ENABLE_ASSIGNMENT_DIAGRAM_IMAGES=true
# ASSIGNMENT_DIAGRAM_IMAGE_MODEL=dall-e-3

# ===== MongoDB =====
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ca_guidance_db
