# Copy to .env and fill in. Used by docker compose.

# MongoDB (use Atlas URI or run: docker compose --profile with-mongodb up)
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=ca_guidance_db
MONGO_DB_NAME_PAPERS=pastpaper_db

# Academic Guidance - Google OAuth (optional for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIRECT_URI=
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-me-in-production

# OpenAI (required for both services if using LLM features)
OPENAI_API_KEY=
# OPENAI_BASE_URL=   # optional, e.g. for local LLM
# OPENAI_MODEL=gpt-4o-mini
