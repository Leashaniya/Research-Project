# Optional: override API bases when NOT using the gateway proxy.
# When unset, the app uses relative paths /guidance and /papers (proxied in dev by Vite to the gateway).

# Academic Guidance backend (auth, summaries, ER, flashcards)
# VITE_API_URL=http://localhost:8000

# Model Paper backend (past papers, lecture slides, generate paper)
# VITE_PAPERS_API_URL=http://localhost:8001

# Dev only: gateway URL for Vite proxy (default: http://localhost:80)
# Use if your gateway runs on another port, e.g. GATEWAY_URL=http://localhost:8080
# GATEWAY_URL=http://localhost:80
